      text: Read the email from your boss
      completeOnFlag: email_read:boss
  - title: Update and submit the quarterly report
    note: 
    objectives:
    - id: 
      text: Sign in to WorkHub (login is in login.txt)
      completeOnFlag: workapp_login
    - id: 
      text: Open the shared folder
      completeOnFlag: opened:sharedfolder
    - id: 
      text: Open the quarterly report
      completeOnFlag: opened:report
    - id: 
      text: Open the totals spreadsheet
      completeOnFlag: opened:spreadsheet
    - id: 
      text: Copy the totals
      completeOnFlag: totals_copied
    - id: 
      text: Paste them into the report
      completeOnFlag: totals_pasted
    - id: 
      text: Save the report
      completeOnFlag: report_saved
    - id: 
      text: Drag the report into WorkHub
      completeOnFlag: report_in_tray
    - id: 
      text: Click Submit
      completeOnFlag: report_submitted
