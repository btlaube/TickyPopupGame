  m_EditorClassIdentifier: Assembly-CSharp::EmailApp
  window: {fileID: 2093132413}
  emails:
  - id: boss
    sender: Dana Wheaton
    subject: 'Q3 Report: needs to be in by 5:00 PM'
    timeLabel: 4:30 pm
    body: "Hi,\n\nFinance closes the books at 5:00 today and the quarterly report
      still has last month\u2019s totals in it.\n\nPlease:\n\nSign in to WorkHub\nOpen
      the shared folder and find the quarterly report\nUpdate it with the numbers
      from the totals spreadsheet on your desktop\nSave it, drag it into WorkHub,
      and hit Submit\n\nI\u2019m in meetings all afternoon and can\u2019t answer
      questions. Do NOT miss this one.\n\nDana"
    deliveredAtStart: 1
  listPanel: {fileID: 1792432377959542094}
  listContent: {fileID: 725835321369255064}
